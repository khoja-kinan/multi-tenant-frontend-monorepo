# Nova (web-client) — copy to .env.local to override. Every value below is
# optional: the app runs entirely against the local mock API by default,
# no backend required.

# Set to "false" to use a real HTTP backend instead of the built-in mocks.
# Anything else (or unset) stays in mock mode.
VITE_ENABLE_API_MOCKS=true

# Only read when VITE_ENABLE_API_MOCKS=false.
VITE_BASE_API_URL=https://api.example.local/

VITE_ENVIRONMENT=demo
