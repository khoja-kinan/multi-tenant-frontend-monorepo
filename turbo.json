{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "typecheck": {
      "outputs": []
    },

    "build": {
      "dependsOn": ["^build", "^typecheck", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "dev:host": {
      "cache": false,
      "persistent": true
    },

    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
